              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/scenarios/1/publish",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "scenarios",
                "1",
                "publish"
              ]
            },
            "description": "08. Публикация черновика",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario_description\": \"Описание сценария для публикации\",\n  \"battery_drain_mah\": 750,\n  \"usage_duration_hours\": 6.5\n}"
            }
          },
          "response": []
        },
        {
          "name": "Поставить / отменить лайк",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/scenarios/1/like",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "scenarios",
                "1",
