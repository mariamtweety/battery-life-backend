{
  "info": {
    "_postman_id": "b3e9447d-2b45-4e78-98bb-5e60882e379a",
    "name": "Battery Life REST API (ЛР4)",
    "description": "Коллекция для демонстрации ЛР4: JWT-аутентификация, публичное чтение, методы создателя, лайк и logout с blacklist в Redis.\n\nПорядок: Register → Login (токен сохраняется в переменную token) → публичные GET без токена → методы создателя с Bearer → Logout. После Logout повторный защищённый запрос должен вернуть 401.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Аутентификация (ЛР4)",
      "item": [
        {
          "name": "Регистрация пользователя",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "register"
              ]
            },
            "description": "01. Регистрация пользователя",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"lab4_user\",\n  \"password\": \"test1234\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Логин: получить JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            },
            "description": "04. Аутентификация: получить JWT",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"tester_alex\",\n  \"password\": \"pass123\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.access_token) { pm.collectionVariables.set('token', data.access_token); }",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Текущий пользователь",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "description": "05. Текущий пользователь (Bearer)"
          },
          "response": []
        },
        {
          "name": "Выход: JWT в blacklist Redis",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "logout"
              ]
            },
            "description": "11. Деавторизация: JWT в blacklist Redis"
          },
          "response": []
        }
      ]
    },
    {
      "name": "02. Публичное чтение (без токена)",
      "item": [
        {
          "name": "Список услуг с фильтром",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/scenarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "scenarios"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Ретро",
                  "description": "Фильтр по названию"
                },
                {
                  "key": "max_hours",
                  "value": "10",
                  "description": "Максимальная длительность"
                }
              ]
            },
            "description": "02. Список услуг с фильтром"
          },
          "response": []
        },
        {
          "name": "Лента: первая опубликованная услуга",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/scenarios/feed",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "scenarios",
                "feed"
              ]
            },
            "description": "03. Лента: первая опубликованная услуга"
          },
          "response": []
        }
      ]
    },
    {
      "name": "03. Методы создателя (Bearer)",
      "item": [
        {
          "name": "Создание черновика (multipart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/scenarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "scenarios"
              ]
            },
            "description": "06. Создание черновика (multipart)",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "scenario_title",
                  "value": "Новый сценарий",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "video",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Получение полей черновика",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/scenarios/draft",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "scenarios",
                "draft"
              ]
            },
            "description": "07. Получение полей черновика"
