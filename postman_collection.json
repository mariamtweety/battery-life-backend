              ]
            },
            "description": "09. Поставить лайк",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"like\": 1\n}"
            }
          },
          "response": []
        },
        {
          "name": "Лента по id: следующий элемент",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/scenarios/feed/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "scenarios",
