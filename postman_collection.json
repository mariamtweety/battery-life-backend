              ],
              "query": [
                {
                  "key": "next",
                  "value": "true"
                }
              ]
            },
            "description": "10. Лента по id: следующий элемент"
          },
          "response": []
        },
        {
          "name": "Логическое удаление услуги",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/scenarios/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "scenarios",
                "1"
              ]
            },
            "description": "12. Логическое удаление услуги"
          },
          "response": []
