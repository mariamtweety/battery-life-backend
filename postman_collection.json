{
	"info": {
		"_postman_id": "b3e9447d-2b45-4e78-98bb-5e60882e379a",
		"name": "Battery Life REST API (ЛР3)",
		"description": "Коллекция из 10 обязательных запросов для демонстрации Лабораторной работы №3 по теме 'Расчет времени автономной работы телефона'.\n\nВсе методы начинаются с префикса /api и следуют принципам REST без добавления 'status: success' в тело ответа.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. GET Список опубликованных сценариев с фильтром",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/scenarios?search=гейминг&max_hours=10",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"scenarios"
					],
					"query": [
						{
							"key": "search",
							"value": "гейминг",
							"description": "Фильтрация по названию сценария"
						},
						{
							"key": "max_hours",
							"value": "10",
							"description": "Фильтрация по максимальной длительности (часы)"
						}
					]
				},
				"description": "Возвращает список только опубликованных сценариев с подсчетом лайков и признаком создателя is_creator (0 или 1)."
			},
			"response": []
		},
		{
			"name": "2. POST Добавление нового сценария с картинкой и видео",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "scenario_title",
							"value": "Навигация в пути",
							"type": "text"
						},
						{
							"key": "scenario_description",
							"value": "Использование GPS-навигатора при поездках на авто",
							"type": "text"
						},
						{
							"key": "battery_drain_mah",
							"value": "650",
							"type": "text"
						},
						{
							"key": "usage_duration_hours",
							"value": "4.5",
							"type": "text"
						},
						{
							"key": "image",
							"type": "file",
							"src": []
						},
						{
							"key": "video",
							"type": "file",
							"src": []
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/api/scenarios",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"scenarios"
					]
				},
				"description": "Создает сценарий в статусе 'draft', загружает файлы изображения и видео в MinIO с латинскими именами и сохраняет URL в БД."
			},
			"response": []
		},
		{
			"name": "3. GET Получение полей черновика пользователя",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/scenarios/draft",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"scenarios",
						"draft"
					]
				},
				"description": "Возвращает поля единственного черновика текущего пользователя (ID пользователя берется из singleton-функции, в URL не передается)."
			},
			"response": []
		},
		{
			"name": "4. PUT Публикация сценария (смена статуса draft -> published)",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"scenario_title\": \"GPS Навигация\",\n  \"scenario_description\": \"Точное ведение по маршруту в авто с постоянной активностью экрана и чипа GPS\",\n  \"battery_drain_mah\": 850,\n  \"usage_duration_hours\": 5.0\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/scenarios/{{scenario_id}}/publish",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"scenarios",
						"{{scenario_id}}",
						"publish"
					]
				},
				"description": "Переводит сценарий из статуса 'draft' в 'published', фиксирует дату формирования formation_date. Изменить статус обратно в draft запрещено."
			},
			"response": []
		},
		{
			"name": "5. GET Получение ленты по ID со следующим сценарием (?id=1&next=true)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/scenarios/feed?id=1&next=true",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"scenarios",
						"feed"
					],
					"query": [
						{
							"key": "id",
							"value": "1",
							"description": "ID сценария"
						},
						{
							"key": "next",
							"value": "true",
							"description": "Переход к следующему сценарию"
						}
					]
				},
				"description": "Возвращает следующий по ID опубликованный сценарий после переданного ID (параметры id и next передаются в query)."
			},
			"response": []
		},
		{
			"name": "6. POST Поставить / отменить лайк сценарию (поле like: 1 или 0)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"like\": 1\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/scenarios/1/like",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"scenarios",
						"1",
						"like"
					]
				},
				"description": "Ставит (1) или снимает (0) лайк от текущего пользователя singleton."
			},
			"response": []
		},
		{
			"name": "7. DELETE Удаление сценария (soft delete)",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/scenarios/{{scenario_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"scenarios",
						"{{scenario_id}}"
					]
				},
				"description": "Логическое удаление сценария (статус переводится в 'deleted'). Разрешено только создателю сценария."
			},
			"response": []
		},
		{
			"name": "8. POST Регистрация нового пользователя",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"username\": \"tester_dmitry\",\n  \"password\": \"secretpassword123\",\n  \"is_moderator\": false\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/users/register",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"users",
						"register"
					]
				},
				"description": "Регистрирует нового пользователя в таблице battery_app_users. Пароль не возвращается в ответе (json:\"-\")."
			},
			"response": []
		},
		{
			"name": "9. POST Аутентификация пользователя (заглушка для ЛР4)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"username\": \"tester_alex\",\n  \"password\": \"pass123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/users/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"users",
						"login"
					]
				},
				"description": "Заглушка авторизации для ЛР4, возвращает сессионный токен и профиль пользователя."
			},
			"response": []
		},
		{
			"name": "10. POST Деавторизация пользователя (заглушка для ЛР4)",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/users/logout",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"users",
						"logout"
					]
				},
				"description": "Заглушка деавторизации для ЛР4."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080"
		},
		{
			"key": "scenario_id",
			"value": "1"
		}
	]
}
